{% extends 'layout.twig' %}
{% block title %}Register: Inkwell{% endblock %}
{% block content %}
<section class="page">
  <div class="wrap narrow">
    <h1>Create your account</h1>
    <form action="/register" method="post" data-ajax="form" class="stack">
      <input type="hidden" name="_csrf" value="{{ csrf }}">
      <div class="field">
        <label for="name">Your name</label>
        <input id="name" name="name" type="text" value="{{ old.name|default('') }}" autocomplete="name" maxlength="100" enterkeyhint="next" required aria-describedby="name-err"{% if errors.name|default('') %} aria-invalid="true"{% endif %}>
        <p class="field__error" id="name-err" data-error-for="name"{% if not errors.name|default('') %} hidden{% endif %}>{{ errors.name|default('') }}</p>
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" value="{{ old.email|default('') }}" autocomplete="username" autocapitalize="none" spellcheck="false" enterkeyhint="next" required aria-describedby="email-err"{% if errors.email|default('') %} aria-invalid="true"{% endif %}>
        <p class="field__error" id="email-err" data-error-for="email"{% if not errors.email|default('') %} hidden{% endif %}>{{ errors.email|default('') }}</p>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="new-password" enterkeyhint="done" required{% if passwordPattern %} pattern="{{ passwordPattern }}"{% endif %} title="{{ passwordHint }}" aria-describedby="password-help password-err"{% if errors.password|default('') %} aria-invalid="true"{% endif %}>
        <p class="t-small muted" id="password-help">Use {{ passwordHint }}.</p>
        <p class="field__error" id="password-err" data-error-for="password"{% if not errors.password|default('') %} hidden{% endif %}>{{ errors.password|default('') }}</p>
      </div>
      <div class="btn-row"><button class="btn btn--primary" type="submit">Create account</button></div>
      <p class="form__status" role="status" data-form-status>{{ errors._form|default('') }}</p>
      <p class="t-small muted">Already registered? <a class="link" href="/login">Log in</a></p>
    </form>
  </div>
</section>
{% endblock %}
