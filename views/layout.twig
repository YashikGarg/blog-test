<!doctype html>
<html lang="en" data-type="service" data-radius="soft" data-buttons="solid" data-motion>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light">
  <meta name="page-type" content="service">
  <meta name="site-kind" content="other">
  <meta name="csrf-token" content="{{ csrf }}">
  <meta name="default-cover" content="{{ defaultCover }}">
  <title>{% block title %}Inkwell: a simple blog{% endblock %}</title>
  <meta name="description" content="{% block description %}Inkwell is a simple blog. Read posts, search them, and log in to comment and upvote.{% endblock %}">
  <meta name="theme-color" content="#f7f3ec">
  <link rel="icon" href="data:,">
  <link rel="preload" href="/assets/fonts/schibsted-grotesk.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/vendor/taste/system.css">
  <link rel="stylesheet" href="/assets/vendor/taste/motion.css">
  <link rel="stylesheet" href="/assets/app.css">
  <script type="module" src="/assets/vendor/taste/system.js"></script>
  <script type="module" src="/assets/vendor/taste/motion.js"></script>
  <script type="module" src="/assets/app.js"></script>
  {% block head_extra %}{% endblock %}
</head>
<body>
<header class="nav">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Skip to content</a>
    <a class="nav__logo" href="/"><span class="mark mark--initial" aria-hidden="true">I</span>Inkwell</a>
    <nav class="nav__links" aria-label="Main">
      <div class="nav__item"><a class="nav__link" href="/">Home</a></div>
      <div class="nav__item"><a class="nav__link" href="/#search">Search</a></div>
      {% if isAdmin %}<div class="nav__item"><a class="nav__link" href="/admin">Admin</a></div>{% endif %}
    </nav>
    <div class="nav__actions">
      {% if currentUser %}
        <span class="nav__user t-small muted">{{ currentUser.name }}</span>
        <form action="/logout" method="post" data-ajax="logout">
          <input type="hidden" name="_csrf" value="{{ csrf }}">
          <button class="btn btn--secondary btn--sm" type="submit">Log out</button>
        </form>
      {% else %}
        <a class="nav__link" href="/login">Log in</a>
        <a class="btn btn--primary" href="/register">Register</a>
      {% endif %}
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>

<main id="top">
  <div class="wrap">
    <div class="flash-area" id="flash" role="status">
      {% for f in flash %}<p class="flash flash--{{ f.type }}">{{ f.message }}</p>{% endfor %}
    </div>
  </div>
  {% block content %}{% endblock %}
</main>

<footer class="site-footer">
  <div class="wrap t-small muted">Inkwell, a simple blog.</div>
</footer>

{# One native modal dialog for every delete confirmation (text set by script from data-confirm). #}
<dialog id="confirm-dialog" aria-labelledby="confirm-title" closedby="any">
  <form method="dialog" class="stack">
    <h2 id="confirm-title" class="t-card">Are you sure?</h2>
    <div class="btn-row">
      <button class="btn btn--secondary" type="submit" value="cancel" autofocus>Cancel</button>
      <button class="btn btn--primary" type="submit" value="confirm">Delete</button>
    </div>
  </form>
</dialog>
</body>
</html>
