APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
DB_HOST=127.0.0.1
DB_PORT=3308
DB_ROOT_PASS=change-me
DB_NAME=inkwell
DB_USER=inkwell_app
DB_PASS=change-me
DB_MIGRATE_USER=inkwell_migrate
DB_MIGRATE_PASS=change-me
DB_SSL_CA=
SESSION_NAME=inkwell_sid
SESSION_SECURE=false
SESSION_LIFETIME=7200
PASSWORD_REGEX='/^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{10,72}$/'
PASSWORD_HINT='10-72 characters with upper, lower case and a number'
LOGIN_FREE_ATTEMPTS=5
LOGIN_IP_FREE_ATTEMPTS=20
LOGIN_BACKOFF_BASE_SECONDS=60
LOGIN_BACKOFF_MAX_SECONDS=7200
UPLOAD_MAX_BYTES=3145728
UPLOAD_ALLOWED_MIMES=image/jpeg,image/png,image/webp,image/gif
DEFAULT_COVER=/assets/default-cover.jpg
CACHE_DRIVER=filesystem
CACHE_TTL=86400
CACHE_COUNT_TTL=300
TWIG_CACHE=false
POSTS_PER_PAGE=10
COMMENT_MAX_LENGTH=2000
COMMENTS_PER_PAGE=30
ADMIN_EMAIL=admin@inkwell.test
ADMIN_PASSWORD=Admin12345x
