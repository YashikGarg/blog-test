{
    "name": "inkwell/blog",
    "description": "Inkwell: a simple blog in plain PHP",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "laminas/laminas-httphandlerrunner": "^2.15",
        "league/commonmark": "^2.10",
        "monolog/monolog": "^3.13",
        "nikic/fast-route": "^1.3",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "php-di/php-di": "^7.1",
        "php-mcp/server": "^3.3",
        "relay/relay": "^3.0",
        "symfony/cache": "^8.1",
        "symfony/clock": "^8.1",
        "symfony/uid": "^8.1",
        "twig/twig": "^3.30",
        "vlucas/phpdotenv": "^5.8"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S localhost:8000 -t public public/index.php",
        "migrate": "php bin/migrate.php",
        "db:up": "docker compose --env-file .env.local up -d --wait",
        "db:down": "docker compose --env-file .env.local down"
    },
    "config": { "sort-packages": true },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    }
}
